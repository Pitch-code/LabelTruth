<?xml version="1.0" encoding="utf-8"?>
<!--
  Security posture: all traffic must be HTTPS. Cleartext is disabled everywhere,
  so a downgrade attack on a hostile network cannot silently succeed.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
